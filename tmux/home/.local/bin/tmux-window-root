#!/usr/bin/env bash
# Badge root d'un onglet, pour la barre d'état de tmux : affiche $1 si un
# processus root tourne dans l'un des panes de la fenêtre ($2… : leurs PID),
# c'est-à-dire le shell du pane ou l'un de ses descendants (sudo, su -, doas,
# shell root…).
#
# Par la filiation et non par le terminal (ps -t pts/N) : un conteneur lancé
# avec un terminal (docker run -t, « tty: true » de compose) a son propre
# devpts, numéroté lui aussi pts/0, pts/1… ; ses processus root étaient alors
# comptés dans l'onglet dont le terminal porte le même numéro.

badge=$1
shift
(( $# )) || exit 0

# Remonte de chaque processus root vers ses ancêtres jusqu'à un pane (au plus
# 64 niveaux : un processus qui meurt pendant la lecture ne fait pas boucler)
/bin/ps -e -o pid=,ppid=,uid= 2>/dev/null | /usr/bin/awk -v panes="$*" '
    { parent[$1] = $2; uid[$1] = $3 }
    END {
        n = split(panes, list, " ")
        for (i = 1; i <= n; i++) pane[list[i]] = 1
        for (p in uid) {
            if (uid[p] != 0) continue
            for (q = p; q > 1 && d++ < 64; q = parent[q])
                if (q in pane) exit 0
            d = 0
        }
        exit 1
    }' && printf '%s' "$badge"
