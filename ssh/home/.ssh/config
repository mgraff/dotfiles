# Configuration ssh commune à toutes les machines.
#
# Pour chaque option, ssh garde la PREMIÈRE valeur trouvée : les réglages
# propres à la machine (hôtes, utilisateurs, clés) sont donc lus d'abord, dans
# ~/.ssh/config.local, un fichier local hors du dépôt (dépôt public : ni nom
# d'hôte interne, ni adresse, ni clé ici). Le hook le crée s'il n'existe pas.
# Les valeurs ci-dessous ne s'appliquent qu'à ce que config.local ne fixe pas.

Include ~/.ssh/config.local

Host *
    # Garde la connexion ouverte à travers un NAT ou un pare-feu inactif, et
    # détecte une connexion morte en 2 minutes (30 s x 4) au lieu de figer
    ServerAliveInterval 30
    ServerAliveCountMax 4

    # Réutilise la première connexion à un hôte pour les suivantes (nouveaux
    # terminaux, git, scp) : pas de nouvelle authentification, ouverture
    # immédiate. Elle reste ouverte 10 minutes après la dernière session.
    # « ssh -O exit <hôte> » la ferme ; « ssh -S none <hôte> » s'en passe.
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 10m

    # Ajoute la clé à l'agent à la première utilisation : la phrase de passe
    # n'est demandée qu'une fois par session
    AddKeysToAgent yes

    # Hôte inconnu : enregistre sa clé sans poser la question. Une clé qui a
    # CHANGÉ pour un hôte connu reste refusée.
    StrictHostKeyChecking accept-new
